# Backend's OWN env — separate from the root shared .env (decision #4).
# Real secrets go here, never in the root file, since that one ends up
# inside the React Native bundle.

APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_dev
CORS_ORIGINS=["http://localhost:5173"]

# Production: point DATABASE_URL at Azure Database for PostgreSQL FLEXIBLE
# SERVER (not Single Server, which is retired) — see
# reference/architecture-decisions.md #5. Get the real value from Azure Key
# Vault / App Service configuration, never commit it.
