# Shared client-facing config — see reference/architecture-decisions.md #4.
#
# RULES, not suggestions:
#  1. Every key here must be safe to ship inside a decompilable mobile app
#     bundle. If it's a secret, it does NOT belong in this file — it belongs
#     in backend/.env (server-only) or Azure Key Vault, never here.
#  2. Every value is duplicated under BOTH bundler-required prefixes because
#     Vite and Expo each only pick up their own prefix. Same value, two keys.
#  3. A pre-commit hook (see .pre-commit-config.yaml, check-public-env hook)
#     fails if a key is added here that isn't *_PUBLIC_* / allowlisted below.
#     Don't bypass it — add the key to the allowlist in that script only if
#     you're certain it's genuinely safe to be public.

VITE_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

VITE_APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Add new shared config above this line, in prefix pairs. Backend-only
# secrets go in backend/.env.example instead — never here.
