# pnpm settings — see reference/architecture-decisions.md #14 (cross-platform
# dependency version divergence) for why these matter.

# Let pnpm auto-resolve a compatible peer dependency when one isn't listed
# explicitly (default true on modern pnpm; pinned here so it's not silently
# relying on whatever default ships next).
auto-install-peers=true

# Do NOT hard-fail installs on peer mismatches. React Native's ecosystem
# frequently has community packages with peer ranges that lag a minor
# version behind but still work fine in practice — strict=true would break
# valid installs. Watch install output for peer warnings instead; that's the
# intended signal, not a install-blocking error.
strict-peer-dependencies=false

# Keep each workspace package's node_modules isolated per its own
# package.json rather than flattening everything to one hoisted version —
# this is what lets apps/web and apps/native resolve different versions of
# the same peer (e.g. react) without colliding. Do not change this to
# "hoisted" without re-reading decision #14 first.
node-linker=isolated
